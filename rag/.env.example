# Shared local configuration for the Streamlit app, Copilot CLI, and RAG ingestion.
# Copy this file to rag/.env and replace the example values. Never commit rag/.env.

# Streamlit test-case generation and gap analysis only. The Copilot CLI uses your
# signed-in Copilot model and does not require an OpenAI API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Required for Jira-backed workflows and full Jira ingestion.
JIRA_URL=https://your-company.atlassian.net
JIRA_USER=your-email@example.com
JIRA_TOKEN=your-atlassian-api-token
JIRA_PROJECT=YOUR_PROJECT_KEY
# Optional JQL clause used during ingestion only.
JIRA_JQL_FILTER=

# Required for TestRail-backed workflows and full TestRail ingestion.
TESTRAIL_URL=https://your-company.testrail.com
TESTRAIL_USER=your-email@example.com
TESTRAIL_TOKEN=your-testrail-api-key
TESTRAIL_PROJECT_ID=YOUR_PROJECT_ID

# Optional: absolute path to the Cypress repository. Required to ingest Cypress
# automation code and to generate Cypress specs grounded in repository chunks.
AUTOMATION_REPO_ROOT=

# Optional legacy Cypress-pattern ingestion path. Prefer AUTOMATION_REPO_ROOT.
CYPRESS_ROOT=

# Ingestion paths are relative to the rag/ directory when running ingest_all.py.
DOCS_DIR=./docs
PDF_DIR=./docs/product_knowledge
FAISS_INDEX_PATH=./faiss_index