# â”€â”€â”€ OpenAI â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Required: used to create embeddings for the FAISS vector store
OPENAI_API_KEY=sk-your-openai-api-key-here

# â”€â”€â”€ Jira (Atlassian) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Your Atlassian cloud URL (e.g. https://yourcompany.atlassian.net)
JIRA_URL=https://yourcompany.atlassian.net
# Your Atlassian account email
JIRA_USER=you@yourcompany.com
# Atlassian API token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_TOKEN=your-atlassian-api-token
# Jira project key to ingest (e.g. STUD)
JIRA_PROJECT=YOUR_PROJECT_KEY
# Optional: JQL filter to narrow scope, e.g. "sprint in openSprints()"
# Leave blank to ingest all issues in the project
JIRA_JQL_FILTER=

# â”€â”€â”€ TestRail â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Your TestRail instance URL (e.g. https://yourcompany.testrail.io)
TESTRAIL_URL=https://yourcompany.testrail.io
# TestRail account email
TESTRAIL_USER=you@yourcompany.com
# TestRail API key (generate in TestRail â†’ My Settings â†’ API Keys)
TESTRAIL_TOKEN=your-testrail-api-key
# TestRail project ID to ingest (find it in the URL when viewing your project)
TESTRAIL_PROJECT_ID=2

# â”€â”€â”€ Paths â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Directory containing product documentation PDFs
PDF_DIR=./pdfs
# Directory containing product documentation Markdown files
DOCS_DIR=./docs
# Path to your Cypress project (for ingesting automation patterns)
CYPRESS_ROOT=/path/to/your/cypress/project
# Path where the FAISS index will be saved/loaded
FAISS_INDEX_PATH=./faiss_index

